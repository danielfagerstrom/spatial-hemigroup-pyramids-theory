import Pyramids.Line.DiscreteCovarianceLine
import Pyramids.Pyramid.NoLatticeKernel
import Pyramids.Pyramid.LatticeStrata

/-!
# `prop:no-lattice-kernel-line`: no kernel from scale zero is a lattice law, the pyramid principle

Blueprint: `blueprint/src/parts/02-line.tex`. Moved from `PyramidsSkeleton.Ch02Line` in wave 2f,
unchanged in statement and name.

* (1): by `lem:line-axioms-kernels` the kernels form a symmetric `q`-covariant family on `ℝ`; its
  image in `ℝ¹` under `x ↦ xe₀` is one too, and `ξℤ` goes to the discrete subgroup generated by
  `ξe₀`; `prop:no-lattice-kernel` at `d = 1` applies.
* (2): in the canonical gauge covariance at `q` iterated gives `μ_{0,qⁿt} = T_{qⁿ}μ_{0,t}`
  (`kernel_zpow_of_cov`); the image of a density under `x ↦ cx` is `c⁻¹φ(c⁻¹ ·)` (by
  `Real.map_volume_mul_left`); two continuous densities of one law agree everywhere.
-/

namespace Pyramids

open AffineHemigroup
open MeasureTheory Set Filter
open ScaleSpace (X IsKernelFamily IsScaleCovariant)
open scoped Topology ENNReal

/-- `‖ξe₀‖ = |ξ|`. -/
theorem norm_lineEmb (x : ℝ) : ‖lineEmb x‖ = |x| := by
  have h := norm_sq_lineEmb x
  rw [← Real.sqrt_sq_eq_abs, ← h, Real.sqrt_sq (norm_nonneg _)]

/-- The subgroup generated by `ξe₀`, `ξ ≠ 0`, is discrete. -/
theorem discreteTopology_zmultiples_lineEmb {ξ : ℝ} (hξ : ξ ≠ 0) :
    DiscreteTopology (AddSubgroup.zmultiples (lineEmb ξ)) := by
  refine discreteTopology_of_isOpen_singleton_zero ?_
  have hopen : IsOpen ((Subtype.val : AddSubgroup.zmultiples (lineEmb ξ) → Rd 1) ⁻¹'
      Metric.ball 0 |ξ|) := Metric.isOpen_ball.preimage continuous_subtype_val
  convert hopen using 1
  ext ⟨x, hx⟩
  simp only [mem_singleton_iff, mem_preimage, Metric.mem_ball, dist_zero_right]
  constructor
  · intro h0
    have hx0 : x = 0 := congrArg Subtype.val h0
    rw [hx0, norm_zero]
    exact abs_pos.2 hξ
  · intro hlt
    obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hx
    rw [norm_zsmul ℝ, norm_lineEmb] at hlt
    have hk : k = 0 := by
      by_contra hk
      have h1 : (1 : ℝ) ≤ ‖(k : ℝ)‖ := by
        rw [Real.norm_eq_abs, ← Int.cast_abs]
        exact_mod_cast Int.one_le_abs hk
      have : |ξ| ≤ ‖(k : ℝ)‖ * |ξ| := le_mul_of_one_le_left (abs_nonneg ξ) h1
      linarith
    subst hk
    rfl

/-- `lineEmb (ξk) = k • lineEmb ξ`. -/
theorem lineEmb_zsmul (ξ : ℝ) (k : ℤ) : lineEmb (ξ * k) = k • lineEmb ξ := by
  rw [lineEmb, lineEmb, ← Int.cast_smul_eq_zsmul ℝ, smul_smul, mul_comm]

theorem lineEmb_injective : Function.Injective lineEmb := fun x y h => by
  have := congrArg (fun z : Rd 1 => z 0) h
  simpa [lineEmb_apply_zero] using this

/-- The kernels of a `q^ℤ`-covariant family form a symmetric family, `q`-covariant with `S_q`. -/
theorem qCovariantLine_family {q : ℝ} {Φ : ℝ → ℝ → (X →L[ℝ] X)} {S : ℝ → ℝ → ℝ}
    (hΦ : IsQCovariantLine q Φ S) {μ : ℝ → ℝ → Measure ℝ} (hμ : IsKernelFamily Φ μ) :
    IsSymmetricFamily μ ∧ IsCovariantAt μ q (S q) := by
  obtain ⟨C, rfl⟩ := hΦ.core
  refine ⟨line_axioms_kernels_1_family C μ hμ, ?_⟩
  have h := (line_axioms_kernels_qcov C μ hμ hΦ.one_lt).1 S hΦ.covariant 1
  rwa [zpow_one] at h

/-- **`prop:no-lattice-kernel-line`(1).** No kernel `μ_{0,t}`, `t > 0`, of a `q^ℤ`-covariant
family is carried by a lattice `ξℤ`. -/
theorem no_lattice_kernel_line_1 {q : ℝ} (Φ : ℝ → ℝ → (X →L[ℝ] X)) (S : ℝ → ℝ → ℝ)
    (hΦ : IsQCovariantLine q Φ S) (μ : ℝ → ℝ → Measure ℝ) (hμ : IsKernelFamily Φ μ) {t : ℝ}
    (ht : 0 < t) {ξ : ℝ} (hξ : 0 < ξ) : μ 0 t {x : ℝ | ¬∃ k : ℤ, x = ξ * k} ≠ 0 := by
  obtain ⟨hsym, hcov⟩ := qCovariantLine_family hΦ hμ
  set Γ : AddSubgroup (Rd 1) := AddSubgroup.zmultiples (lineEmb ξ) with hΓ
  haveI : DiscreteTopology Γ := discreteTopology_zmultiples_lineEmb hξ.ne'
  have h := no_lattice_kernel (d := 1) le_rfl (fun s t => (μ s t).map lineEmbL)
    (isSymmetricFamily_lineEmb hsym) hΦ.one_lt ⟨_, isCovariantAt_lineEmb hcov⟩ ht Γ
  have hΓm : MeasurableSet ((Γ : Set (Rd 1))ᶜ) :=
    (countable_of_discrete Γ).measurableSet.compl
  rw [Measure.map_apply lineEmbL.continuous.measurable hΓm] at h
  convert h using 2
  ext x
  simp only [mem_setOf_eq, mem_preimage, mem_compl_iff, SetLike.mem_coe, hΓ,
    AddSubgroup.mem_zmultiples_iff, lineEmbL_apply]
  refine not_congr ⟨fun ⟨k, hk⟩ => ⟨k, by rw [hk, lineEmb_zsmul]⟩, fun ⟨k, hk⟩ => ⟨k, ?_⟩⟩
  rw [← lineEmb_zsmul] at hk
  exact lineEmb_injective hk.symm

/-- The image of a density under `x ↦ cx`, `c > 0`, has the density `c⁻¹φ(c⁻¹ ·)`. -/
theorem map_mul_withDensity {c : ℝ} (hc : 0 < c) {φ : ℝ → ℝ} (hφm : Measurable φ) :
    (volume.withDensity fun x => ENNReal.ofReal (φ x)).map (fun x => c * x) =
      volume.withDensity fun x => ENNReal.ofReal (c⁻¹ * φ (c⁻¹ * x)) := by
  ext s hs
  have hm : Measurable fun x : ℝ => c * x := measurable_const_mul c
  rw [Measure.map_apply hm hs, withDensity_apply _ (hm hs), withDensity_apply _ hs]
  -- the change of variables `y = cx`
  have hcv : ∀ g : ℝ → ℝ≥0∞, Measurable g →
      ∫⁻ x, g (c * x) = ENNReal.ofReal c⁻¹ * ∫⁻ y, g y := by
    intro g hg
    rw [← lintegral_map hg hm, Real.map_volume_mul_left hc.ne', lintegral_smul_measure,
      abs_of_pos (inv_pos.2 hc), smul_eq_mul]
  have hcinv : ENNReal.ofReal c⁻¹ ≠ 0 := by
    rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]
    exact inv_pos.2 hc
  have hgm : Measurable fun y : ℝ => s.indicator (fun y => ENNReal.ofReal (c⁻¹ * φ (c⁻¹ * y))) y :=
    (by fun_prop : Measurable fun y : ℝ => ENNReal.ofReal (c⁻¹ * φ (c⁻¹ * y))).indicator hs
  refine (ENNReal.mul_right_inj hcinv ENNReal.ofReal_ne_top).1 ?_
  rw [← lintegral_indicator hs, ← hcv _ hgm, ← lintegral_indicator (hm hs), ← lintegral_const_mul]
  · refine lintegral_congr fun x => ?_
    by_cases hx : c * x ∈ s
    · have hx' : x ∈ (fun x => c * x) ⁻¹' s := hx
      rw [indicator_of_mem hx', indicator_of_mem hx, ← ENNReal.ofReal_mul (inv_pos.2 hc).le,
        ← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
    · have hx' : x ∉ (fun x => c * x) ⁻¹' s := hx
      rw [indicator_of_notMem hx', indicator_of_notMem hx, mul_zero]
  · exact (by fun_prop : Measurable fun x : ℝ => ENNReal.ofReal (φ x)).indicator (hm hs)

/-- **`prop:no-lattice-kernel-line`(2), the pyramid principle.** In the canonical discrete gauge,
if `μ_{0,t}` has a continuous density `φ_t`, then `μ_{0,q^n t}` has the continuous density
`q^{-n} φ_t(q^{-n} ·)`, every continuous density of it is that one, and
`q^n φ_{q^n t}(q^n hm) = φ_t(hm)`. -/
theorem no_lattice_kernel_line_2 {q : ℝ} (Φ : ℝ → ℝ → (X →L[ℝ] X)) (S : ℝ → ℝ → ℝ)
    (hΦ : IsQCovariantLine q Φ S) (hcan : IsCanonicalDiscreteGauge q S)
    (μ : ℝ → ℝ → Measure ℝ) (hμ : IsKernelFamily Φ μ) {t : ℝ} (ht : 0 < t) (φ : ℝ → ℝ)
    (hφc : Continuous φ) (hφ0 : ∀ x, 0 ≤ φ x)
    (hφ : μ 0 t = volume.withDensity fun x => ENNReal.ofReal (φ x)) (n : ℤ) :
    Continuous (fun x => q ^ (-n) * φ (q ^ (-n) * x)) ∧
      μ 0 (q ^ n * t) = volume.withDensity (fun x => ENNReal.ofReal (q ^ (-n) * φ (q ^ (-n) * x))) ∧
      ∀ φ' : ℝ → ℝ, Continuous φ' → (∀ x, 0 ≤ φ' x) →
        μ 0 (q ^ n * t) = volume.withDensity (fun x => ENNReal.ofReal (φ' x)) →
          (∀ x, φ' x = q ^ (-n) * φ (q ^ (-n) * x)) ∧
            ∀ h : ℝ, 0 < h → ∀ m : ℤ, q ^ n * φ' (q ^ n * h * m) = φ (h * m) := by
  have hq := hΦ.one_lt
  have hq0 : 0 < q := by linarith
  obtain ⟨hsym, hcovS⟩ := qCovariantLine_family hΦ hμ
  have hcov : IsCovariantAt μ q (fun t => q * t) := isCovariantAt_mul_of_eqOn hq0 hcovS hcan
  have hqn : 0 < q ^ n := zpow_pos hq0 n
  have hψc : Continuous (fun x => q ^ (-n) * φ (q ^ (-n) * x)) := by fun_prop
  have hkern : μ 0 (q ^ n * t) =
      volume.withDensity (fun x => ENNReal.ofReal (q ^ (-n) * φ (q ^ (-n) * x))) := by
    rw [kernel_zpow_of_cov hq hcov n t ht.le, hφ]
    simp only [smul_eq_mul]
    rw [map_mul_withDensity hqn hφc.measurable, zpow_neg]
  refine ⟨hψc, hkern, fun φ' hφ'c hφ'0 hφ' => ?_⟩
  have heq : ∀ x, φ' x = q ^ (-n) * φ (q ^ (-n) * x) := by
    have hae := (withDensity_eq_iff_of_sigmaFinite
      (by fun_prop : Measurable fun x : ℝ => ENNReal.ofReal (φ' x)).aemeasurable
      (by fun_prop : Measurable fun x : ℝ =>
        ENNReal.ofReal (q ^ (-n) * φ (q ^ (-n) * x))).aemeasurable).1 (hφ'.symm.trans hkern)
    have hae' : φ' =ᵐ[volume] fun x => q ^ (-n) * φ (q ^ (-n) * x) := by
      filter_upwards [hae] with x hx
      exact (ENNReal.ofReal_eq_ofReal_iff (hφ'0 x)
        (mul_nonneg (zpow_pos hq0 _).le (hφ0 _))).1 hx
    exact congrFun ((hφ'c.ae_eq_iff_eq volume hψc).1 hae')
  refine ⟨heq, fun h _ m => ?_⟩
  rw [heq, zpow_neg, ← mul_assoc, mul_inv_cancel₀ hqn.ne', one_mul, ← mul_assoc,
    ← mul_assoc, inv_mul_cancel₀ hqn.ne', one_mul]

end Pyramids
